{
    "name": "wmd/craft-design-field",
    "description": "One field for every design option of a block: tone, spacing, layout, columns and more, picked from named choices you define once. Swatches, picture tiles, sliders and position grids; options that only show when they apply.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "craft-plugin",
        "field",
        "design-system",
        "design-tokens",
        "tailwind",
        "page-builder",
        "matrix",
        "blocks"
    ],
    "authors": [
        {
            "name": "WMD",
            "homepage": "https://wmd.hr/"
        }
    ],
    "support": {
        "docs": "https://github.com/WMD-hosting/craft-design-field/blob/2.x/README.md",
        "issues": "https://github.com/WMD-hosting/craft-design-field/issues"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "wmd\\designfield\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wmd\\designfield\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "design-field",
        "name": "Design Field",
        "developer": "WMD",
        "developerUrl": "https://wmd.hr/",
        "class": "wmd\\designfield\\Plugin",
        "documentationUrl": "https://github.com/WMD-hosting/craft-design-field/blob/2.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/WMD-hosting/craft-design-field/2.x/CHANGELOG.md"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
